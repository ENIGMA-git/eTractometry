includeConfig "configs/bundles.config"
includeConfig "configs/mean_iso_surface.config"

conda     { enabled = false }
apptainer { enabled = false; autoMounts = true }

workflow {
    failOnIgnore = false
    output.mode  = 'link'
}

trace {
    enabled   = true
    overwrite = true
    fields    = 'task_id,hash,native_id,name,tag,status,exit,attempt,submit,duration,realtime,%cpu,peak_rss,peak_vmem,rchar,wchar,memory,time'
}

process {

    afterScript = {
        def safe_process = task.process.replace(':', '-')
        def safe_tag = (task.tag ?: "process").replace(':', '-')

        """
        mkdir -p "${params.output_dir}/reports/logs/${safe_process}"
        {
            printf "\\nProcess: %s\\nTask hash: %s\\nTask directory: %s\\n" "${task.process}" "${task.hash}" "${task.workDir}"
            printf "\\nTask command:\\n";  [ -f .command.sh ]  && cat .command.sh  || echo "No .command.sh."
            printf "\\nTask output:\\n";   [ -f .command.log ] && cat .command.log || echo "No .command.log."
            printf "\\nTask error:\\n";    [ -f .command.err ] && cat .command.err || echo "No .command.err."
        } > "${params.output_dir}/reports/logs/${safe_process}/${safe_tag}_\$(date +%Y-%m-%d_%H-%M-%S).txt"
        """
}
    errorStrategy = 'ignore'
    maxRetries    = 3
    maxErrors     = '-1'

    cpus = 1
    withLabel: 'dsi_studio' { cpus = 3 }
    withLabel: 'heavy'   { memory = { 20.GB * task.attempt }; maxForks = 450 }
    withLabel: 'medium'  { memory = { 16.GB * task.attempt }; maxForks = 450 }
    withLabel: 'light'   { memory = {  12.GB * task.attempt }; maxForks = 450 }
    withLabel: 'minimal' { memory = {  8.GB * task.attempt }; maxForks = 450 }
}

executor {
    jobName = {
        def codes = [
            RECONSTRUCT_GQI        : 'GQI',
            IMPORT_EXTRA_MAPS      : 'Extra_maps',
            SEGMENT_BUNDLES        : 'Segment_bundle',
            META_TRACTOMETRY       : 'MeTA',
            BUAN_TRACTOMETRY       : 'BUAN',
            BUNDLE_METRICS         : 'Bundle_metrics',
            GROUP_MEAN_BUNDLE      : 'Cohort_mean',
            RENDER_MODEL_QC        : 'Model_QC',
            RENDER_BUNDLE_QC       : 'Bundle_QC',
            AGGREGATE_META_PROFILES: 'MeTA_profile',
            AGGREGATE_BUAN_PROFILES: 'BUAN_profile',
            AGGREGATE_SHAPE_METRICS: 'Shape_metrics',
            AGGREGATE_SIMILARITY   : 'Similarity_metrics',
            BUILD_DIFFUSION_HTML   : 'dMRI_HTML',
            BUILD_META_HTML        : 'MeTA_HTML',
            BUILD_BUAN_HTML        : 'BUAN_HTML',
            BUILD_TRACT_HTML       : 'Bundle_HTML',
            CHECK_RUN_COMPLETENESS : 'Check_report',
        ]
        def proc = task.process.tokenize(':').last()
        def code = codes.get(proc, proc.take(6))
        def name = task.tag ? "${code}_${task.tag.toString().tokenize('_')[0]}" : code
        name.replaceAll(/[^A-Za-z0-9_.-]/, '_')
    }
}

profiles {

    local { process.executor = 'local' }
    sge {
        process.executor           = 'sge'
        process.array              = 250
        executor.submitRateLimit   = '20 / 1sec'
        executor.pollInterval      = '1 min'
        executor.queueStatInterval = '5 min'
    }

    slurm {
        process.executor         = 'slurm'
        process.array            = 250
        executor.submitRateLimit   = '20 / 1sec'
        executor.pollInterval      = '1 min'
        executor.queueStatInterval = '5 min'
    }
    pbs {
        process.executor         = 'pbs'
        process.array            = 250
        executor.submitRateLimit   = '20 / 1sec'
        executor.pollInterval      = '1 min'
        executor.queueStatInterval = '5 min'
    }
    pbspro {
        process.executor         = 'pbspro'
        process.array            = 250
        executor.submitRateLimit   = '20 / 1sec'
        executor.pollInterval      = '1 min'
        executor.queueStatInterval = '5 min'
    }
    lsf {
        process.executor         = 'lsf'
        process.array            = 250
        executor.submitRateLimit   = '20 / 1sec'
        executor.pollInterval      = '1 min'
        executor.queueStatInterval = '5 min'
    }

    conda {
        conda.enabled = true
        process {
            withLabel: 'dsi_studio'   { beforeScript = { "export PATH=${new File(params.dsi_studio_bin.toString()).parent}:\$PATH" } }
            withLabel: 'python_tools' { conda        = { "${params.python_env}" } }
        }
    }
    apptainer {
        apptainer.enabled = true
        process {
            withLabel: 'dsi_studio'   { container = "${projectDir}/bin/dsistudio.sif" }
            withLabel: 'python_tools' { container = "${projectDir}/bin/enigma_tractometry.sif" }
        }
    }
    hybrid {
        apptainer.enabled = true
        conda.enabled     = true
        process {
            withLabel: 'dsi_studio'   { container = "${projectDir}/bin/dsistudio.sif" }
            withLabel: 'python_tools' { conda     = { "${params.python_env}" } }
        }
    }

    finalize { cleanup = true }
}
